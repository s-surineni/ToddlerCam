<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_sub_option"
    android:padding="24dp"
    android:layout_margin="16dp"
    android:gravity="center_horizontal">

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔒 Parent Verification"
        android:textColor="#3F51B5"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tv_gate_question"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Solve the math problem to enter:"
        android:textColor="#666666"
        android:textSize="15sp"
        android:gravity="center"
        android:layout_marginBottom="20dp" />

    <!-- Answer Input -->
    <EditText
        android:id="@+id/et_gate_answer"
        android:layout_width="140dp"
        android:layout_height="50dp"
        android:inputType="number"
        android:gravity="center"
        android:textSize="20sp"
        android:textStyle="bold"
        android:hint="Answer"
        android:textColor="#333333"
        android:background="@drawable/card_sub_option"
        android:layout_marginBottom="24dp"
        android:importantForAutofill="no"
        android:maxLength="3" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_cancel_gate"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:background="@drawable/card_sub_option"
            android:gravity="center"
            android:text="Cancel"
            android:textColor="#666666"
            android:textSize="16sp"
            android:layout_marginEnd="8dp"
            android:filterTouchesWhenObscured="true" android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/btn_verify_gate"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:background="@drawable/card_sub_option"
            android:backgroundTint="#3F51B5"
            android:gravity="center"
            android:text="Verify"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp"
            android:filterTouchesWhenObscured="true" android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

</LinearLayout>
