<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_sub_option"
    android:padding="24dp"
    android:layout_margin="16dp"
    android:gravity="center_horizontal">

    <!-- Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🛡️ Parent Safety Guide"
        android:textColor="#3F51B5"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"
        android:layout_marginBottom="16dp" />

    <!-- Description of Pinning -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="To prevent your child from leaving this app accidentally, please turn on App Pinning (Screen Pinning):"
        android:textColor="#333333"
        android:textSize="14sp"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="start"
        android:layout_marginBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1. Open device Settings ⚙️"
            android:textColor="#555555"
            android:textSize="13sp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2. Search for 'App Pinning' or 'Screen Pinning' and turn it ON."
            android:textColor="#555555"
            android:textSize="13sp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3. Open ToddlerCam, swipe up (or hold Overview/Back) and tap Pin."
            android:textColor="#555555"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_open_settings"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1.2"
            android:background="@drawable/card_sub_option"
            android:gravity="center"
            android:text="Open Settings ⚙️"
            android:textColor="#3F51B5"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginEnd="8dp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/btn_close_guide"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="0.8"
            android:background="@drawable/card_sub_option"
            android:backgroundTint="#3F51B5"
            android:gravity="center"
            android:text="OK"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

</LinearLayout>
